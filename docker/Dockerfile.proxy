# syntax=docker/dockerfile:1.7
#
# boxy sidecar — the only container with a foot in both the box's private
# network and the outside world. It carries traffic in both directions:
#
#   ingress   socat listeners that publish the box's ports. The box sits on an
#             `internal` network, where Docker refuses to create a host port
#             binding at all, so the binding lives here instead.
#   egress    tinyproxy with a domain allowlist, for `--net limited` only.
#
# One of these runs per isolated box.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends tinyproxy socat iproute2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY docker/proxy-entrypoint.sh /usr/local/bin/boxy-proxy-entrypoint
RUN chmod 755 /usr/local/bin/boxy-proxy-entrypoint

EXPOSE 8888
ENTRYPOINT ["/usr/local/bin/boxy-proxy-entrypoint"]
