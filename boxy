#!/usr/bin/env bash
#
# boxy — disposable, SSH-reachable dev boxes backed by Docker.
#
#   boxy create .            # mount the current directory
#   boxy create worktree     # a new worktree of the repo you are in
#   boxy ls
#   boxy ssh boxy-1
#
# Written for bash 3.2 (the macOS system bash), so: no associative arrays,
# no mapfile, no ${x,,}. Docker labels are the source of truth for instance
# state — there is no separate database to drift out of sync.

set -euo pipefail

BOXY_VERSION="1.0.0"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ===========================================================================
# Configuration
# ===========================================================================
# Precedence: built-in defaults < config file < BOXY_* environment < flags.

BOXY_CONFIG_DIR="${BOXY_CONFIG_DIR:-$HOME/.config/boxy}"
BOXY_CONFIG_FILE="${BOXY_CONFIG_FILE:-$BOXY_CONFIG_DIR/config}"

# Defaults, applied only where the config file / environment leave a gap.
: "${BOXY_STATE_DIR:=$HOME/.local/share/boxy}"
: "${BOXY_IMAGE:=boxy:latest}"
: "${BOXY_PROXY_IMAGE:=boxy-proxy:latest}"
: "${BOXY_USER:=boxyboy}"

# Where a box's workdir goes when you don't pass -d. The OS reaps temp
# directories on its own schedule, which is the right owner for scratch space:
# boxy neither tracks it nor deletes it, so there is no lifecycle to reason
# about. A directory you pass with -d is yours and is never touched.
# (macOS sets TMPDIR with a trailing slash, hence the %/.)
_BOXY_TMP="${TMPDIR:-/tmp}"
: "${BOXY_WORKDIR_BASE:=${_BOXY_TMP%/}/boxy}"
unset _BOXY_TMP

: "${BOXY_SSH_PORT_BASE:=2200}"

# The "known set of ports" that `boxy forward` tunnels when you don't name any.
# These are NOT published to the host automatically — publishing is explicit
# (`-p`), because an implicit host->container mapping you have to decode from a
# list's ordering is worse than no mapping at all.
: "${BOXY_PORTS:=2718 8888 8000 8080 3000 5000 6006}"

# Published ports bind to loopback only.
: "${BOXY_BIND_ADDR:=127.0.0.1}"

# Capability policy: minimal | default.
#
# `minimal` drops the four capabilities nothing in a dev box legitimately
# needs. It deliberately KEEPS the ones whose absence causes confusing
# failures rather than honest ones:
#   NET_RAW           /usr/bin/ping carries cap_net_raw=ep, and a file
#                     capability with the *effective* bit set makes exec()
#                     itself fail when the capability is outside the bounding
#                     set. You do not get a degraded ping, you get
#                     "exec /usr/bin/ping: operation not permitted".
#   KILL              root cannot signal another user's process without it, so
#                     `sudo pkill -f marimo` fails.
#   NET_BIND_SERVICE  redundant while Docker sets ip_unprivileged_port_start=0,
#                     but a hardened daemon may not, and then low-port binds
#                     break for no visible reason.
#   AUDIT_WRITE       PAM writes login records with it.
# What goes: MKNOD (device nodes), SETPCAP/SETFCAP (capability manipulation),
# FSETID (setuid-bit preservation). None have a plausible use here.
: "${BOXY_CAPS:=minimal}"
: "${BOXY_MINIMAL_CAPS:=CHOWN DAC_OVERRIDE FOWNER KILL SETGID SETUID SYS_CHROOT NET_BIND_SERVICE NET_RAW AUDIT_WRITE}"

: "${BOXY_NET:=full}"

# Boxes do not come back on their own.
#
# This used to be load-bearing: isolation was applied from outside the
# container after `docker run`, so a daemon-driven restart — which does not go
# through boxy — brought a `--net none` box back fully connected while it was
# still labelled isolated. It is not load-bearing any more. A box sits alone on
# an `internal` network, and that is a property of the network definition
# rather than of the running container, so there is nothing a restart can
# undo and nothing for boxy to reapply.
#
# What is left is a lifecycle preference, and `no` is still the right one: a
# box is scratch space you are expected to `boxy rm`, and one you forgot about
# should stay gone after a reboot rather than quietly reclaiming its SSH port.
: "${BOXY_RESTART:=no}"

: "${BOXY_CPUS:=}"
: "${BOXY_MEMORY:=}"

WORDLIST_URL="https://www.eff.org/files/2016/07/18/eff_large_wordlist.txt"
WORDLIST_COUNT=7776

DEFAULT_ALLOWLIST='# boxy egress allowlist — one domain per line, subdomains included.
# Used by `boxy create --net limited`. Edit freely.

# Python
pypi.org
files.pythonhosted.org
# conda / conda-forge
conda.anaconda.org
repo.anaconda.com
anaconda.org
# uv / ruff
astral.sh
# git hosting
github.com
api.github.com
codeload.github.com
raw.githubusercontent.com
objects.githubusercontent.com
ghcr.io
gitlab.com
# node
registry.npmjs.org
# debian
deb.debian.org
security.debian.org
# ML artifacts
storage.googleapis.com
huggingface.co
cdn-lfs.huggingface.co
cdn-lfs-us-1.hf.co
# anthropic (claude code inside the box)
api.anthropic.com
statsig.anthropic.com
sentry.io
'

# ===========================================================================
# Output helpers
# ===========================================================================
if [ -t 2 ]; then
    C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'
    C_DIM=$'\033[2m'; C_BLD=$'\033[1m'; C_OFF=$'\033[0m'
else
    C_RED=''; C_GRN=''; C_YEL=''; C_DIM=''; C_BLD=''; C_OFF=''
fi

info() { printf '%s\n' "$*" >&2; }
note() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF" >&2; }
warn() { printf '%swarning:%s %s\n' "$C_YEL" "$C_OFF" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }
ok()   { printf '%s%s%s\n' "$C_GRN" "$*" "$C_OFF" >&2; }

# ===========================================================================
# Small utilities
# ===========================================================================

load_config() {
    if [ -f "$BOXY_CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        . "$BOXY_CONFIG_FILE"
    fi
}

# Defaults that are derived from other settings must be resolved AFTER the
# config file has been sourced, or a config that moves BOXY_STATE_DIR would
# still get a key path computed from the built-in one.
apply_derived_defaults() {
    # boxy's own keypair lives in boxy's own state dir, not ~/.ssh: boxy
    # creates and manages it, so it belongs where `rm -rf "$BOXY_STATE_DIR"`
    # is a complete uninstall. Nothing boxy does touches ~/.ssh unless you
    # explicitly run `boxy ssh-config --install`. Point this at your own key
    # in the config file if you would rather supply one.
    : "${BOXY_SSH_KEY:=$BOXY_STATE_DIR/boxy_ed25519}"
}

require_docker() {
    command -v docker >/dev/null 2>&1 || die "docker not found on PATH"
    docker info >/dev/null 2>&1 \
        || die "cannot reach the docker daemon. Is Docker running?"
}

image_exists() { docker image inspect "$1" >/dev/null 2>&1; }

# Unbiased random integer in [0,N) from /dev/urandom. Rejection sampling
# rather than a plain modulo, because `rand % 7776` over 16 bits skews the
# first 1216 words upward — small, but there is no reason to accept it in a
# password generator.
rand_below() {
    local n="$1" limit r
    limit=$(( 65536 - (65536 % n) ))
    while :; do
        r=$(od -An -N2 -tu2 < /dev/urandom | tr -d ' ')
        if [ "$r" -lt "$limit" ]; then
            printf '%s\n' $(( r % n ))
            return 0
        fi
    done
}

wordlist_path() { printf '%s\n' "$BOXY_STATE_DIR/eff_large_wordlist.txt"; }

ensure_wordlist() {
    local wl
    wl="$(wordlist_path)"
    if [ -f "$wl" ] && [ "$(wc -l < "$wl" | tr -d ' ')" = "$WORDLIST_COUNT" ]; then
        return 0
    fi
    mkdir -p "$BOXY_STATE_DIR"
    if curl -fsSL --max-time 20 -o "$wl.tmp" "$WORDLIST_URL" 2>/dev/null \
        && [ "$(wc -l < "$wl.tmp" | tr -d ' ')" = "$WORDLIST_COUNT" ]; then
        mv "$wl.tmp" "$wl"
        note "cached EFF long wordlist ($WORDLIST_COUNT words) at $wl"
        return 0
    fi
    rm -f "$wl.tmp"
    return 1
}

# Four words from the EFF long list is ~51.7 bits of entropy. That is the
# whole point of the 7776-word list: log2(7776) is exactly 12.925 bits per
# word, and the words are chosen to be unambiguous when typed or dictated.
#
# The count is fixed. It was briefly tunable, which only ever offered a way to
# pick a worse number: this password guards sudo inside a container whose SSH
# is key-only, so anything above four buys nothing you can measure, and
# anything below it is a downgrade nobody would choose deliberately.
PASSWORD_WORDS=4

gen_password() {
    local words="$PASSWORD_WORDS" wl out i idx word
    out=""
    if ensure_wordlist; then
        wl="$(wordlist_path)"
        i=0
        while [ "$i" -lt "$words" ]; do
            idx=$(( $(rand_below "$WORDLIST_COUNT") + 1 ))
            # Lines look like "16656  vocation" — take the second field.
            word="$(sed -n "${idx}p" "$wl" | awk '{print $2}')"
            [ -n "$word" ] || continue
            if [ -z "$out" ]; then out="$word"; else out="$out-$word"; fi
            i=$(( i + 1 ))
        done
        printf '%s\n' "$out"
        return 0
    fi

    warn "could not fetch the EFF wordlist; falling back to a local dictionary"
    if [ -r /usr/share/dict/words ]; then
        local total
        total="$(wc -l < /usr/share/dict/words | tr -d ' ')"
        i=0
        while [ "$i" -lt "$words" ]; do
            idx=$(( $(rand_below "$total") + 1 ))
            word="$(sed -n "${idx}p" /usr/share/dict/words \
                    | tr -cd '[:alpha:]' | tr '[:upper:]' '[:lower:]')"
            [ -n "$word" ] || continue
            if [ -z "$out" ]; then out="$word"; else out="$out-$word"; fi
            i=$(( i + 1 ))
        done
        printf '%s\n' "$out"
        return 0
    fi

    warn "no dictionary available; using base64 randomness"
    LC_ALL=C od -An -N24 -tx1 < /dev/urandom | tr -d ' \n'
    printf '\n'
}

# Hash the password on the HOST. Only the hash ever crosses into the
# container, so the plaintext appears in no image layer, no `docker inspect`
# output, and no /proc/<pid>/environ inside the box.
hash_password() {
    local plain="$1"
    if command -v openssl >/dev/null 2>&1 \
        && printf 'x' | openssl passwd -6 -stdin >/dev/null 2>&1; then
        printf '%s' "$plain" | openssl passwd -6 -stdin
        return 0
    fi
    # Fall back to mkpasswd inside the image, fed over stdin so the plaintext
    # is never a process argument visible in `ps`.
    if image_exists "$BOXY_IMAGE"; then
        printf '%s' "$plain" \
            | docker run --rm -i --network none "$BOXY_IMAGE" \
                mkpasswd --method=sha512crypt --stdin
        return 0
    fi
    die "no way to hash the password (need openssl with -6, or the $BOXY_IMAGE image)"
}

# TCP connect probe. A successful connect means something is already there.
#
# The connect runs in a subshell so the descriptor is closed for us when that
# subshell exits. Do NOT "tidy up" with `exec 3>&- 2>/dev/null` here: `exec`
# with redirections and no command rewires the CURRENT shell permanently, and
# that stray 2>/dev/null would silently discard every warning the script
# printed from this point on.
port_free() {
    if ( exec 3<>/dev/tcp/127.0.0.1/"$1" ) 2>/dev/null; then
        return 1
    fi
    return 0
}

state_dir_for() { printf '%s\n' "$BOXY_STATE_DIR/instances/$1"; }

# Count state directories with no container behind them.
#
# These appear when a box is removed outside boxy (`docker rm` by hand). The
# contents — host key, known_hosts, password — mean nothing without the
# container, so they are pure litter.
orphan_state_dirs() {
    local d name
    [ -d "$BOXY_STATE_DIR/instances" ] || return 0
    for d in "$BOXY_STATE_DIR"/instances/*/; do
        [ -d "$d" ] || continue
        name="$(basename "$d")"
        instance_exists "$name" || printf '%s\n' "$name"
    done
}

prune_orphan_state() {
    local name n=0
    for name in $(orphan_state_dirs); do
        rm -rf "$BOXY_STATE_DIR/instances/$name"
        n=$(( n + 1 ))
    done
    [ "$n" -gt 0 ] && note "pruned $n orphaned state director$( [ "$n" = 1 ] && echo y || echo ies )"
    return 0
}

# Read a boxy label off a container.
#
# Labels are boxy's entire state store, so this is the hottest call in the
# script — `boxy info` alone wants eight of them. Fetching one label per
# `docker inspect` meant eight process spawns to print one box, so the whole
# label set is fetched once and cached. A container's labels are fixed at
# creation, which is what makes caching safe; the cache keys on the container
# name and refetches whenever it changes.
# The cache has to be filled by a call made as a PLAIN STATEMENT, never inside
# `$( … )`. inst_label is always used in command substitution, and a subshell
# can read the parent's variables but its writes die with it — so memoizing
# inside inst_label itself would populate and discard the cache every time.
_LBL_NAME=""
_LBL_DATA=""
inst_label_load() {
    [ "$1" = "$_LBL_NAME" ] && return 0
    _LBL_DATA="$(docker inspect -f '{{range $k, $v := .Config.Labels}}{{$k}}={{$v}}
{{end}}' "$1" 2>/dev/null || true)"
    _LBL_NAME="$1"
}

inst_label() {
    local name="$1" key="$2"
    if [ "$name" != "$_LBL_NAME" ]; then
        # Nobody preloaded this container: fall back to a single lookup so
        # correctness never depends on remembering to call inst_label_load.
        docker inspect -f "{{index .Config.Labels \"$key\"}}" "$name" 2>/dev/null || true
        return 0
    fi
    # Exact prefix match at position 1, so `boxy.net` cannot be satisfied by
    # some other label that merely contains that text.
    printf '%s\n' "$_LBL_DATA" \
        | awk -v k="$key=" 'index($0, k) == 1 { print substr($0, length(k) + 1); exit }'
}

# Every BOX, oldest first.
#
# Filters on boxy.role=box, not merely boxy.managed=1: proxy sidecars carry
# the managed label too, and counting them made "the name may be omitted when
# exactly one box exists" false for any --net limited box — `boxy ssh` would
# refuse with "there are 2".
list_instances() {
    docker ps -a --filter 'label=boxy.role=box' --format '{{.Names}}' \
        | sort -t- -k2 -n 2>/dev/null || true
}

instance_exists() {
    docker container inspect "$1" >/dev/null 2>&1
}

require_instance() {
    local name="$1"
    [ -n "$name" ] || die "instance name required"
    instance_exists "$name" || die "no such instance: $name"
    [ "$(inst_label "$name" boxy.managed)" = "1" ] \
        || die "container '$name' exists but is not managed by boxy"
}

# If exactly one instance exists, let the user omit the name.
resolve_instance() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        local all count
        all="$(list_instances)"
        count="$(printf '%s\n' "$all" | grep -c . || true)"
        if [ "$count" = "0" ]; then
            die "no boxes exist — create one with 'boxy create'"
        fi
        if [ "$count" != "1" ]; then
            die "$count boxes exist, so the name is not optional here: $(printf '%s' "$all" | tr '\n' ' ')"
        fi
        name="$(printf '%s\n' "$all" | head -1)"
    fi
    require_instance "$name"
    printf '%s\n' "$name"
}

ensure_ssh_key() {
    local priv="$BOXY_SSH_KEY" pub="$BOXY_SSH_KEY.pub"
    if [ -f "$pub" ]; then return 0; fi
    if [ -f "$priv" ]; then
        ssh-keygen -y -f "$priv" > "$pub" || die "cannot derive public key from $priv"
        return 0
    fi
    info "no boxy keypair at $priv — generating one"
    mkdir -p "$(dirname "$priv")"
    chmod 700 "$(dirname "$priv")" 2>/dev/null || true
    ssh-keygen -q -t ed25519 -N '' -C "boxy@$(hostname -s 2>/dev/null || echo local)" -f "$priv" \
        || die "ssh-keygen failed"
    ok "created $priv"
}

allowlist_file() { printf '%s\n' "$BOXY_CONFIG_DIR/allowlist.txt"; }

ensure_allowlist() {
    local f
    f="$(allowlist_file)"
    if [ ! -f "$f" ]; then
        mkdir -p "$BOXY_CONFIG_DIR"
        printf '%s' "$DEFAULT_ALLOWLIST" > "$f"
        note "wrote default egress allowlist to $f"
    fi
}

# ===========================================================================
# Networks
# ===========================================================================
# Restricted boxes get their own ordinary bridge:
#   boxy-iso-<name>   INTERNAL. The box lives here alone; Docker itself
#                     guarantees no egress, and there is nothing to reapply
#                     after a restart because it is a property of the network.
#   boxy-egress       ordinary bridge — only sidecars live here
# The sidecar sits on both, which makes it the single, auditable way in or out.

# `internal` here is the whole of boxy's egress isolation.
#
# Docker enforces it in the network itself: no default route is installed, no
# NAT rule exists for the subnet, and external DNS resolution is dead. Unlike
# anything applied to a running container, it is part of the network's
# definition, so it survives a restart and cannot be undone from inside the
# box — there is no state for a restart to rebuild wrongly.
#
# The cost is that Docker will not create a host port binding for a container
# whose only network is internal: `-p` is accepted and silently discarded, and
# `docker port` reports nothing. Published ports therefore live on the sidecar,
# which is dual-homed. See create_prepare_network.
ensure_network() {
    local net="$1" internal="${2:-0}"
    docker network inspect "$net" >/dev/null 2>&1 && return 0
    if [ "$internal" = "1" ]; then
        docker network create --internal "$net" >/dev/null
    else
        docker network create "$net" >/dev/null
    fi
}

remove_network_if_unused() {
    local net="$1" used
    docker network inspect "$net" >/dev/null 2>&1 || return 0
    used="$(docker network inspect -f '{{len .Containers}}' "$net" 2>/dev/null || echo 1)"
    [ "$used" = "0" ] && docker network rm "$net" >/dev/null 2>&1 || true
}

# ===========================================================================
# build
# ===========================================================================
cmd_build() {
    require_docker
    local nocache="" extras=0 claude=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-cache) nocache="--no-cache" ;;
            --full)     extras=1; claude=1 ;;
            --extras)   extras=1 ;;
            --claude)   claude=1 ;;
            -h|--help)
                cat >&2 <<'EOF'
usage: boxy build [--no-cache] [--full | --extras | --claude]

  (default)   numpy scipy pandas matplotlib-base jax marimo ipython uv
              conda/mamba node  — the stack you asked for, 2.3 GB
  --extras    + jupyterlab polars pyarrow scikit-learn      (+462 MB)
  --claude    + @anthropic-ai/claude-code inside the box    (+291 MB)
  --full      both of the above

Anything omitted is still one `uv pip install` away inside a running box.
EOF
                return 0 ;;
            *) die "build: unknown option $1" ;;
        esac
        shift
    done

    info "building $BOXY_IMAGE (extras=$extras claude-code=$claude)"
    # shellcheck disable=SC2086
    docker build $nocache \
        --build-arg "INSTALL_EXTRAS=$extras" \
        --build-arg "INSTALL_CLAUDE_CODE=$claude" \
        -t "$BOXY_IMAGE" -f "$SELF_DIR/Dockerfile" "$SELF_DIR"

    info "building $BOXY_PROXY_IMAGE"
    # shellcheck disable=SC2086
    docker build $nocache -t "$BOXY_PROXY_IMAGE" -f "$SELF_DIR/docker/Dockerfile.proxy" "$SELF_DIR"

    ok "images ready: $BOXY_IMAGE, $BOXY_PROXY_IMAGE"
}

# ===========================================================================
# create
# ===========================================================================
usage_create() {
    cat >&2 <<'EOF'
usage: boxy create [TARGET] [options]

TARGET determines host directory to be mounted as /work:

  .  or PATH    TARGET -> /work                    boxy create .
  worktree      a git worktree of the current repo  boxy create worktree
  (omitted)     new scratch dir in $TMPDIR          boxy create

Worktree gets a new branch (boxy/NAME) and shares history with your
repo, so commits made in the box are viewable in your repo.
Your main checkout is not mounted and cannot be touched.

options:
  -b, --ref REF         commit-ish the worktree branches from (def: HEAD)
  -n, --name NAME       instance name (default: boxy-N)
      --password PASS   sudo password (default: random EFF passphrase)
  -u, --user NAME       login user inside the box (default: boxyboy)
  -k, --key PATH        public key to authorize (def: $BOXY_SSH_KEY.pub)
      --net MODE        full | none | limited        (default: full)
      --caps MODE       minimal | docker-default     (default: minimal)
      --allow DOMAIN    extra allowed domain for --net limited (repeats)
  -p, --publish SPEC    publish a port, docker-style (repeatable):
                          -p 2718       -> localhost:2718 -> box 2718
                          -p 12718:2718 -> localhost:12718 -> box 2718
                        Default is none; use `boxy forward` instead.
      --image IMG       image to run (default: boxy:latest)
      --cpus N          CPU limit
      --memory SIZE     memory limit, e.g. 8g

Anything after `--` is passed to `docker run` unchanged, for example:

  boxy create . -- -v ~/data:/data
  boxy create . -- --gpus all --shm-size 2g

These land after boxy's own flags. Where docker takes the last value of
a repeated flag (--cpus, --memory) yours wins; where it accumulates
(-v, -e, --cap-add) yours is added to boxy's. Two caveats:

  --network  boxy's to set; use --net full|none|limited instead
  -e K=V     reaches the box's own processes and `boxy exec`, but NOT
             `boxy ssh`, which gets its env from PAM. Use `boxy env`.
EOF
}

cmd_create() {
    require_docker
    prune_orphan_state
    nb_reset
    # The only non-zero return from parsing is --help, which has already
    # printed usage; anything genuinely wrong calls die() and exits.
    if ! create_parse_args "$@"; then return 0; fi
    create_validate
    create_plan_ports
    create_prepare_dirs
    create_prepare_password
    create_prepare_network
    create_assemble_run_args
    create_launch
    create_report
}

# ---------------------------------------------------------------------------
# create: the parameter block
# ---------------------------------------------------------------------------
# `boxy create` is a pipeline whose stages need to share about twenty values.
# Bash functions return a status, not a struct, so the choice is a documented
# block of globals or one 300-line function. This is the former: every field
# is prefixed NB_ ("new box"), written only by create_* functions, and cleared
# at the start of every run so nothing leaks between invocations.
nb_reset() {
    NB_TARGET=""; NB_SOURCE=""; NB_MOUNT_DIR=""; NB_REF=""; NB_NAME=""
    NB_WT_REPO=""; NB_WT_GITDIR=""; NB_WT_BRANCH=""
    NB_PASSWORD=""; NB_PW_HASH=""; NB_PW_GENERATED=0
    NB_USER="$BOXY_USER"; NB_PUBKEY=""
    NB_NET="$BOXY_NET"; NB_IMAGE="$BOXY_IMAGE"
    NB_CAPS="$BOXY_CAPS"
    NB_CPUS="$BOXY_CPUS"; NB_MEMORY="$BOXY_MEMORY"
    NB_IDX=""; NB_SSH_PORT=""; NB_PUBLISHED=""
    NB_SDIR=""; NB_WORKDIR=""; NB_AUTHORIZED_KEYS=""
    NB_NET_NAME=""; NB_SIDECAR_NAME=""; NB_PROXY_URL=""
    NB_ALLOW=(); NB_PUBLISH=(); NB_DOCKER=()
    RUN_ARGS=()
}

# Append to the docker-run argument vector.
#
# bash 3.2 has no `arr+=(x)`, so without this helper every single docker flag
# costs two lines of `RUN_ARGS[${#RUN_ARGS[@]}]=` noise — which was 37 lines of
# pure boilerplate in the original.
arg() { while [ $# -gt 0 ]; do RUN_ARGS[${#RUN_ARGS[@]}]="$1"; shift; done; }

# Append to an NB_ list. Same reason.
nb_push_allow()   { NB_ALLOW[${#NB_ALLOW[@]}]="$1"; }
nb_push_publish() { NB_PUBLISH[${#NB_PUBLISH[@]}]="$1"; }

# ---------------------------------------------------------------------------
# create: stages
# ---------------------------------------------------------------------------

# Returns non-zero only for --help.
create_parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -b|--ref)       NB_REF="${2:?--ref needs a value}";            shift 2 ;;
            -n|--name)      NB_NAME="${2:?--name needs a value}";          shift 2 ;;
            --password)     NB_PASSWORD="${2:?--password needs a value}";  shift 2 ;;
            -u|--user)      NB_USER="${2:?--user needs a value}";          shift 2 ;;
            -k|--key)       NB_PUBKEY="${2:?--key needs a value}";         shift 2 ;;
            --net)          NB_NET="${2:?--net needs a value}";            shift 2 ;;
            --caps)         NB_CAPS="${2:?--caps needs a value}";          shift 2 ;;
            --allow)        nb_push_allow   "${2:?--allow needs a value}"; shift 2 ;;
            -p|--publish)   nb_push_publish "${2:?--publish needs a value}"; shift 2 ;;
            --image)        NB_IMAGE="${2:?--image needs a value}";        shift 2 ;;
            --cpus)         NB_CPUS="${2:?--cpus needs a value}";          shift 2 ;;
            --memory)       NB_MEMORY="${2:?--memory needs a value}";      shift 2 ;;
            -h|--help)      usage_create; return 1 ;;
            # Everything after `--` reaches `docker run` untouched. This is
            # what lets the option list stay short: boxy does not need a
            # wrapper flag for each docker feature, because the feature itself
            # is still one `--` away. `-v` and `-e` were exactly that kind of
            # wrapper and are gone; `boxy create . -- -v ~/data:/data` is the
            # replacement, and it also covers --gpus, --shm-size and the rest
            # of docker without boxy having to grow a line per flag.
            --)
                shift
                while [ $# -gt 0 ]; do
                    NB_DOCKER[${#NB_DOCKER[@]}]="$1"; shift
                done ;;
            -*)             die "create: unknown option $1 (try 'boxy create --help')" ;;
            # The one positional: what goes in /work. Accepted before or after
            # the flags, so both `boxy create . -n web` and `boxy create -n web .`
            # read naturally.
            *)
                [ -z "$NB_TARGET" ] \
                    || die "create: one target at a time (got '$NB_TARGET' and '$1')"
                NB_TARGET="$1"; shift ;;
        esac
    done
    return 0
}

create_validate() {
    case "$NB_NET" in
        full|none|limited) ;;
        *) die "--net must be one of: full, none, limited" ;;
    esac
    # `default` is the old spelling of `docker-default`. It was a bad name: it
    # meant "Docker's default set", but boxy's default is `minimal`, so the
    # value named `default` was the one you never got by default. Still
    # accepted, silently, so existing configs and scripts keep working.
    [ "$NB_CAPS" = "default" ] && NB_CAPS="docker-default"
    case "$NB_CAPS" in
        minimal|docker-default) ;;
        *) die "--caps must be one of: minimal, docker-default" ;;
    esac

    # The passthrough is deliberately unpoliced except here. The network is the
    # one thing boxy cannot let you set behind its back: `--net` picks it, the
    # sidecar attaches to it, `boxy rm` tears it down, and `boxy info` reports
    # isolation by reading it. A passthrough --network would leave all four
    # describing a box that no longer exists — the label would say `none` over
    # a fully connected container, which is precisely the failure the internal-
    # network design was built to make impossible.
    local d
    for d in ${NB_DOCKER[@]+"${NB_DOCKER[@]}"}; do
        case "$d" in
            --network|--network=*|--net|--net=*)
                die "create: the network is boxy's to set — use 'boxy create --net full|none|limited' rather than passing $d through" ;;
        esac
    done

    # Check the name against Docker's own rule here, before create does any
    # real work. Otherwise a bad name is only caught by `docker run` at the
    # very end, after a password has been generated and directories and
    # networks created — and the error names none of that.
    if [ -n "$NB_NAME" ]; then
        printf '%s' "$NB_NAME" | grep -qE '^[a-zA-Z0-9][a-zA-Z0-9_.-]+$' \
            || die "--name '$NB_NAME' is not a usable container name: needs 2+ characters, starting with a letter or digit, then letters, digits, '_', '.' or '-'"
    fi
    create_resolve_target

    image_exists "$NB_IMAGE" || die "image '$NB_IMAGE' not found — run: boxy build"
    if [ "$NB_NET" = "limited" ]; then
        image_exists "$BOXY_PROXY_IMAGE" \
            || die "proxy image '$BOXY_PROXY_IMAGE' not found — run: boxy build"
        ensure_allowlist
    fi

    ensure_ssh_key
    [ -n "$NB_PUBKEY" ] || NB_PUBKEY="$BOXY_SSH_KEY.pub"
    [ -f "$NB_PUBKEY" ] || die "public key not found: $NB_PUBKEY"
    NB_AUTHORIZED_KEYS="$(cat "$NB_PUBKEY")"
}

# Work out what the single positional means, and prove it can work before
# create allocates ports, generates a password or builds any directories.
#
# Three sources, one of which needs a git repo under the cursor:
#   ""         scratch   a fresh temp dir
#   worktree   worktree  a new worktree of the repo containing $PWD
#   PATH       dir       that directory, mounted as-is
create_resolve_target() {
    case "$NB_TARGET" in
        "")
            NB_SOURCE="scratch" ;;
        worktree)
            # A directory can also be named "worktree". The keyword wins,
            # because it is what you meant almost every time, and ./worktree
            # says the other thing unambiguously. An `if` rather than
            # `[ … ] && die`, which under `set -e` is only safe as long as it
            # is not the last statement in its branch.
            if [ -e "worktree" ]; then
                die "'worktree' here is also a real path — write ./worktree to mount that directory, or run boxy create worktree from elsewhere"
            fi
            NB_SOURCE="worktree"
            create_resolve_worktree ;;
        *)
            NB_SOURCE="dir"
            [ -d "$NB_TARGET" ] || die "not a directory: $NB_TARGET"
            NB_MOUNT_DIR="$NB_TARGET" ;;
    esac

    if [ -n "$NB_REF" ] && [ "$NB_SOURCE" != "worktree" ]; then
        die "--ref only means something with 'boxy create worktree'"
    fi
}

# Locate the repo to branch from, and confirm the ref resolves. Nothing is
# created here; that happens in create_prepare_dirs once the name is known.
create_resolve_worktree() {
    command -v git >/dev/null 2>&1 || die "boxy create worktree needs git on PATH"
    git rev-parse --git-dir >/dev/null 2>&1 \
        || die "boxy create worktree must be run inside a git repository"

    NB_WT_REPO="$(git rev-parse --show-toplevel)"
    git rev-parse --verify --quiet "${NB_REF:-HEAD}^{commit}" >/dev/null \
        || die "--ref '$NB_REF' does not name a commit in $NB_WT_REPO"
}

# Normalise -p specs, then claim an instance index and its SSH port.
#
# `-p 2718` means the same number on both sides; `-p 12718:2718` states it
# explicitly. Either way the mapping is declared, never inferred from a port's
# position in some list.
create_plan_ports() {
    local spec hp cp
    for spec in ${NB_PUBLISH[@]+"${NB_PUBLISH[@]}"}; do
        case "$spec" in
            *:*) hp="${spec%%:*}"; cp="${spec##*:}" ;;
            *)   hp="$spec";       cp="$spec" ;;
        esac
        printf '%s' "$hp$cp" | grep -qE '^[0-9]+$' \
            || die "--publish: expected PORT or HOSTPORT:PORT, got '$spec'"
        port_free "$hp" || die "--publish $spec: host port $hp is already in use"
        NB_PUBLISHED="$NB_PUBLISHED $hp:$cp"
    done
    NB_PUBLISHED="${NB_PUBLISHED# }"

    local used_idx idx=1
    used_idx="$(for c in $(list_instances); do inst_label "$c" boxy.index; done)"
    while :; do
        NB_SSH_PORT=$(( BOXY_SSH_PORT_BASE + idx - 1 ))
        if ! printf '%s\n' "$used_idx" | grep -qx "$idx" && port_free "$NB_SSH_PORT"; then
            break
        fi
        idx=$(( idx + 1 ))
        [ "$idx" -gt 200 ] && die "could not find a free instance slot below 200"
    done
    NB_IDX="$idx"

    [ -n "$NB_NAME" ] || NB_NAME="boxy-$NB_IDX"
    instance_exists "$NB_NAME" && die "instance '$NB_NAME' already exists"
    return 0
}

create_prepare_dirs() {
    # State is bookkeeping only — host keys, known_hosts, the password file.
    # It lives exactly as long as the container does; `boxy rm` deletes it.
    NB_SDIR="$(state_dir_for "$NB_NAME")"
    mkdir -p "$NB_SDIR/hostkeys"
    chmod 700 "$NB_SDIR"

    case "$NB_SOURCE" in
        # A directory you named is yours: mounted as-is, never created,
        # never removed.
        dir)
            NB_WORKDIR="$(cd "$NB_MOUNT_DIR" && pwd)" ;;
        # Scratch space in the OS temp area. mktemp rather than a fixed path
        # per name, so a recreated box never inherits a previous one's files.
        scratch)
            NB_WORKDIR="$(new_scratch_dir)" ;;
        worktree)
            NB_WORKDIR="$(new_scratch_dir)"
            NB_WT_BRANCH="$(unused_branch_name "$NB_WT_REPO" "boxy/$NB_NAME")"
            info "adding worktree $NB_WT_BRANCH to $NB_WT_REPO"
            # git is happy to populate an existing empty directory, which is
            # what mktemp -d just handed us.
            git -C "$NB_WT_REPO" worktree add --quiet \
                -b "$NB_WT_BRANCH" "$NB_WORKDIR" "${NB_REF:-HEAD}" \
                || die "git worktree add failed"
            NB_WT_GITDIR="$(worktree_git_common_dir "$NB_WORKDIR")"
            ;;
    esac
}

# Read back the path git itself wrote, rather than deriving one and hoping it
# matches. A worktree's .git is a file holding
#     gitdir: /abs/path/to/repo/.git/worktrees/<name>
# and that exact string is what git will follow from inside the container, so
# it is the only correct thing to mount. Deriving it instead with `cd … && pwd`
# is wrong on macOS, where /tmp is a symlink to /private/tmp: git records the
# physical path, the shell reports the logical one, and the mount lands beside
# the pointer rather than under it — leaving a box whose repo does not open.
worktree_git_common_dir() {
    local ptr common
    ptr="$(sed -n 's/^gitdir: //p' "$1/.git" 2>/dev/null)"
    [ -n "$ptr" ] || die "worktree at $1 has no gitdir pointer"
    common="${ptr%/worktrees/*}"
    [ -d "$common" ] || die "worktree points at $common, which is not a directory"
    printf '%s' "$common"
}

new_scratch_dir() {
    mkdir -p "$BOXY_WORKDIR_BASE"
    mktemp -d "$BOXY_WORKDIR_BASE/$NB_NAME.XXXXXX" \
        || die "could not create a workdir under $BOXY_WORKDIR_BASE"
}

# boxy rm deliberately keeps a worktree's branch — it may hold the only copy
# of the work. So names get reused: create boxy-1, rm it, create boxy-1 again,
# and boxy/boxy-1 is still there. Suffix rather than fail.
unused_branch_name() {
    local repo="$1" base="$2" n=2 candidate="$2"
    while git -C "$repo" show-ref --verify --quiet "refs/heads/$candidate"; do
        candidate="$base-$n"
        n=$(( n + 1 ))
    done
    printf '%s' "$candidate"
}

create_prepare_password() {
    if [ -z "$NB_PASSWORD" ]; then
        NB_PASSWORD="$(gen_password)"
        NB_PW_GENERATED=1
    fi
    NB_PW_HASH="$(hash_password "$NB_PASSWORD")"
    [ -n "$NB_PW_HASH" ] || die "password hashing produced nothing"

    # Plaintext stays here, host-side, 0600 — never handed to the container.
    ( umask 077; printf '%s\n' "$NB_PASSWORD" > "$NB_SDIR/password" )
}

# An isolated box sits alone on an `internal` network and publishes nothing.
# Everything that has to reach it — SSH included — arrives through a sidecar
# that is the only container on both that network and the outside.
#
# Why the sidecar is not itself an attack surface for the box: traffic only
# ever flows host -> sidecar -> box, so the sidecar never needs to accept a
# connection from the box. Its listeners bind to its outward address only, and
# the private side is left bare — verified from inside a box: every port
# closed, by IP and by name, and no route out even when handed one explicitly.
# It also runs with no capabilities and with IP forwarding switched off, so it
# cannot be turned into a router.
create_prepare_network() {
    if [ "$NB_NET" = "full" ]; then
        NB_NET_NAME="boxy-net"
        ensure_network "$NB_NET_NAME"
        return 0
    fi

    NB_NET_NAME="boxy-iso-$NB_NAME"
    ensure_network "$NB_NET_NAME" 1          # internal: Docker enforces egress
    ensure_network "boxy-egress"             # the sidecar's outward network
    NB_SIDECAR_NAME="boxy-sidecar-$NB_NAME"

    # Ingress map, one "listenport:box:targetport" per line. The listen port
    # equals the host port so the two never have to be reasoned about apart.
    local relay pair
    relay="$NB_SSH_PORT:$NB_NAME:22"
    for pair in $NB_PUBLISHED; do
        relay="$relay
${pair%%:*}:$NB_NAME:${pair##*:}"
    done

    local caps="--cap-drop=ALL"
    local envs=()
    if [ "$NB_NET" = "limited" ]; then
        NB_PROXY_URL="http://$NB_SIDECAR_NAME:8888"
        local allowlist a
        allowlist="$(grep -v '^[[:space:]]*#' "$(allowlist_file)" | grep -v '^[[:space:]]*$' || true)"
        for a in ${NB_ALLOW[@]+"${NB_ALLOW[@]}"}; do
            allowlist="$allowlist
$a"
        done
        [ -n "$allowlist" ] || die "egress allowlist is empty; nothing would be reachable"
        envs[${#envs[@]}]="-e"; envs[${#envs[@]}]="BOXY_ALLOWLIST=$allowlist"
        # tinyproxy starts as root and drops to its own user, which needs these
        # two back. socat alone needs nothing.
        caps="$caps --cap-add=SETUID --cap-add=SETGID --cap-add=SETPCAP"
    fi

    info "starting sidecar $NB_SIDECAR_NAME"
    # shellcheck disable=SC2086
    docker run -d \
        --name "$NB_SIDECAR_NAME" \
        --hostname "$NB_SIDECAR_NAME" \
        --restart "$BOXY_RESTART" \
        --network "boxy-egress" \
        $caps \
        --sysctl net.ipv4.ip_forward=0 \
        --label boxy.managed=1 \
        --label boxy.role=sidecar \
        --label "boxy.instance=$NB_NAME" \
        -p "$BOXY_BIND_ADDR:$NB_SSH_PORT:$NB_SSH_PORT" \
        $(for pair in $NB_PUBLISHED; do printf -- '-p %s:%s:%s ' "$BOXY_BIND_ADDR" "${pair%%:*}" "${pair%%:*}"; done) \
        -e "BOXY_RELAY=$relay" \
        ${envs[@]+"${envs[@]}"} \
        "$BOXY_PROXY_IMAGE" >/dev/null

    # Second attachment, after creation: the port bindings above only exist
    # because the sidecar was created on a non-internal network. Attaching the
    # box's network now lets it reach the box without giving the box anything.
    docker network connect "$NB_NET_NAME" "$NB_SIDECAR_NAME"
}

create_assemble_run_args() {
    arg -d
    arg --name "$NB_NAME" --hostname "$NB_NAME"
    arg --restart "$BOXY_RESTART" --network "$NB_NET_NAME"

    # Labels are boxy's entire state store — see inst_label().
    arg --label "boxy.managed=1"
    arg --label "boxy.role=box"
    arg --label "boxy.index=$NB_IDX"
    arg --label "boxy.ssh_port=$NB_SSH_PORT"
    arg --label "boxy.published=$NB_PUBLISHED"
    arg --label "boxy.workdir=$NB_WORKDIR"
    arg --label "boxy.source=$NB_SOURCE"
    arg --label "boxy.worktree_repo=$NB_WT_REPO"
    arg --label "boxy.worktree_branch=$NB_WT_BRANCH"
    arg --label "boxy.net=$NB_NET"
    arg --label "boxy.caps=$NB_CAPS"
    arg --label "boxy.user=$NB_USER"
    arg --label "boxy.created=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    # Only a `full` box binds host ports itself. An isolated box is alone on
    # an internal network, where Docker discards `-p` without a word, so its
    # bindings live on the sidecar instead.
    if [ "$NB_NET" = "full" ]; then
        arg -p "$BOXY_BIND_ADDR:$NB_SSH_PORT:22"
        local pair
        for pair in $NB_PUBLISHED; do
            arg -p "$BOXY_BIND_ADDR:${pair%%:*}:${pair##*:}"
        done
    fi

    arg -v "$NB_WORKDIR:/work"
    arg -v "$NB_SDIR/hostkeys:/etc/ssh/hostkeys"

    # A worktree's .git is a *file* holding an absolute path to the main
    # repository's git dir — a host path, which means /work alone is a broken
    # repo inside the box. Mounting the shared git dir at the very path the
    # pointer names makes it whole, and makes it the same object the host has,
    # so a commit in the box is on the branch in your repo immediately.
    #
    # Note what is NOT mounted: your main checkout. The box shares history and
    # nothing else.
    if [ -n "$NB_WT_GITDIR" ]; then
        arg -v "$NB_WT_GITDIR:$NB_WT_GITDIR"
        arg -e "BOXY_GIT_COMMON_DIR=$NB_WT_GITDIR"
    fi

    arg -e "BOXY_NAME=$NB_NAME"
    arg -e "BOXY_USER=$NB_USER"
    arg -e "BOXY_AUTHORIZED_KEYS=$NB_AUTHORIZED_KEYS"
    arg -e "BOXY_PASSWORD_HASH=$NB_PW_HASH"
    [ -n "$NB_PROXY_URL" ] && arg -e "BOXY_PROXY_URL=$NB_PROXY_URL"


    # Match the host user's ids so bind-mounted files are not owned by a
    # stranger — but only on Linux, where a bind mount passes numeric
    # ownership through untranslated. Docker Desktop's file sharing already
    # presents mounted files as the container user, so remapping there buys
    # nothing and costs a multi-minute recursive chown of the conda prefix.
    if [ "$(uname -s)" = "Linux" ]; then
        arg -e "BOXY_UID=$(id -u)" -e "BOXY_GID=$(id -g)"
    fi

    [ -n "$NB_CPUS" ]   && arg --cpus "$NB_CPUS"
    [ -n "$NB_MEMORY" ] && arg --memory "$NB_MEMORY"

    # Capability policy. `docker-default` leaves Docker's own set alone.
    if [ "$NB_CAPS" = "minimal" ]; then
        arg --cap-drop=ALL
        local cap
        for cap in $BOXY_MINIMAL_CAPS; do arg --cap-add="$cap"; done
    fi

    # Passthrough goes last, so that where docker takes the final value of a
    # repeated flag, yours is the final one. That is the difference between an
    # escape hatch and a second opinion: `-- --cpus 4` has to beat boxy's
    # --cpus, not lose to it. Flags docker accumulates rather than overwrites
    # (-v, -e, --cap-add) simply add to what boxy already set.
    arg ${NB_DOCKER[@]+"${NB_DOCKER[@]}"}

    return 0
}

create_launch() {
    if ! docker run "${RUN_ARGS[@]}" "$NB_IMAGE" >/dev/null; then
        # Roll back anything this run created, so a failed create does not
        # leave a half-built box behind.
        [ -n "$NB_SIDECAR_NAME" ] && docker rm -f "$NB_SIDECAR_NAME" >/dev/null 2>&1
        [ "$NB_NET" != "full" ] && remove_network_if_unused "$NB_NET_NAME"
        die "docker run failed"
    fi

    if ! wait_for_ready "$NB_NAME"; then
        warn "the box did not become SSH-reachable within the timeout. Recent logs:"
        docker logs --tail 30 "$NB_NAME" >&2 || true
        warn "'boxy exec $NB_NAME' works without SSH and is the quickest way in."
    fi
    return 0
}

create_report() {
    local pair
    printf '\n'
    ok "created instance $NB_IDX ($NB_NAME), ssh at port $NB_SSH_PORT"
    printf '  %sssh%s     ssh -F %s %s        %s(or: boxy ssh %s)%s\n' \
        "$C_BLD" "$C_OFF" "$(ssh_config_path)" "$NB_NAME" "$C_DIM" "$NB_NAME" "$C_OFF"
    printf '  %sdirect%s  ssh -p %s -i %s %s@%s\n' \
        "$C_BLD" "$C_OFF" "$NB_SSH_PORT" "$BOXY_SSH_KEY" "$NB_USER" "127.0.0.1"
    printf '  %sworkdir%s %s -> /work\n' "$C_BLD" "$C_OFF" "$NB_WORKDIR"
    if [ -n "$NB_WT_BRANCH" ]; then
        printf '  %sbranch%s  %s   %s(shares history with %s)%s\n' \
            "$C_BLD" "$C_OFF" "$NB_WT_BRANCH" "$C_DIM" "$NB_WT_REPO" "$C_OFF"
    fi

    printf '  %snet%s     %s' "$C_BLD" "$C_OFF" "$NB_NET"
    [ -n "$NB_SIDECAR_NAME" ] && printf ' (sidecar %s)' "$NB_SIDECAR_NAME"
    printf '\n'

    if [ "$NB_PW_GENERATED" = "1" ]; then
        printf '  %ssudo pw%s %s   %s(boxy password %s)%s\n' \
            "$C_BLD" "$C_OFF" "$NB_PASSWORD" "$C_DIM" "$NB_NAME" "$C_OFF"
    else
        printf '  %ssudo pw%s (as supplied)   %s(boxy password %s)%s\n' \
            "$C_BLD" "$C_OFF" "$C_DIM" "$NB_NAME" "$C_OFF"
    fi

    if [ -n "$NB_PUBLISHED" ]; then
        printf '  %sports%s   ' "$C_BLD" "$C_OFF"
        for pair in $NB_PUBLISHED; do
            printf 'localhost:%s -> %s   ' "${pair%%:*}" "${pair##*:}"
        done
        printf '\n'
    else
        printf '  %sports%s   none published — %sboxy forward %s%s tunnels %s\n' \
            "$C_BLD" "$C_OFF" "$C_DIM" "$NB_NAME" "$C_OFF" "$BOXY_PORTS"
    fi
    write_ssh_config >/dev/null
}

container_running() {
    [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]
}

# Wait until the box is genuinely usable, then pin its host key.
#
# Note what this deliberately does NOT do: probe the published host port.
# docker-proxy binds that the instant the container is created, long before
# sshd exists, so a port probe reports "ready" immediately and hands you a box
# that refuses every connection. The only honest check is a real handshake.
wait_for_ready() {
    local name="$1" sdir cfg tries=0
    sdir="$(state_dir_for "$name")"

    # Phase 1 — host keys appear on the shared bind mount early in the
    # entrypoint, and we need them before we can pin anything.
    while [ "$tries" -lt 90 ]; do
        [ -f "$sdir/hostkeys/ssh_host_ed25519_key.pub" ] && break
        container_running "$name" || return 1
        sleep 1
        tries=$(( tries + 1 ))
    done
    [ -f "$sdir/hostkeys/ssh_host_ed25519_key.pub" ] || return 1

    write_known_hosts "$name"
    cfg="$(write_ssh_config)"

    # Phase 2 — an actual authenticated connection, which exercises the whole
    # path at once: port publishing, sshd, host key, and authorized_keys.
    tries=0
    while [ "$tries" -lt 90 ]; do
        if ssh -F "$cfg" -o BatchMode=yes -o ConnectTimeout=5 "$name" true 2>/dev/null; then
            return 0
        fi
        container_running "$name" || return 1
        sleep 1
        tries=$(( tries + 1 ))
    done
    return 1
}

# Read the box's public host key straight off the bind-mounted state dir and
# write a known_hosts entry. No trust-on-first-use prompt, and no blanket
# StrictHostKeyChecking=no: the host key is verified from the first connection.
write_known_hosts() {
    local name="$1" sdir port pubfile
    sdir="$(state_dir_for "$name")"
    port="$(inst_label "$name" boxy.ssh_port)"
    : > "$sdir/known_hosts"
    for pubfile in "$sdir"/hostkeys/*.pub; do
        [ -f "$pubfile" ] || continue
        printf '[%s]:%s %s\n' "127.0.0.1" "$port" "$(cut -d' ' -f1,2 < "$pubfile")" \
            >> "$sdir/known_hosts"
    done
    chmod 600 "$sdir/known_hosts"
}

# ===========================================================================
# ssh config
# ===========================================================================
ssh_config_path() { printf '%s\n' "$BOXY_STATE_DIR/ssh_config"; }

# Regenerate a standalone ssh_config covering every live box. `ssh -F` this
# file, or Include it from ~/.ssh/config, and `ssh boxy-1` just works — which
# is what lets an agent treat a box as an ordinary remote host.
write_ssh_config() {
    local out name port user sdir
    out="$(ssh_config_path)"
    mkdir -p "$BOXY_STATE_DIR"
    {
        printf '# Generated by boxy %s — regenerated on every create/rm.\n' "$BOXY_VERSION"
        printf '# Do not edit; put overrides in %s.\n\n' "$BOXY_CONFIG_FILE"
        for name in $(list_instances); do
            inst_label_load "$name"
            [ "$(inst_label "$name" boxy.role)" = "box" ] || continue
            port="$(inst_label "$name" boxy.ssh_port)"
            user="$(inst_label "$name" boxy.user)"
            sdir="$(state_dir_for "$name")"
            printf 'Host %s\n' "$name"
            printf '    HostName %s\n' "127.0.0.1"
            printf '    Port %s\n' "$port"
            printf '    User %s\n' "$user"
            printf '    IdentityFile %s\n' "$BOXY_SSH_KEY"
            printf '    IdentitiesOnly yes\n'
            printf '    UserKnownHostsFile %s\n' "$sdir/known_hosts"
            printf '    StrictHostKeyChecking yes\n'
            printf '    ForwardAgent no\n'
            printf '    ServerAliveInterval 30\n\n'
        done
    } > "$out"
    printf '%s\n' "$out"
}

cmd_ssh_config() {
    require_docker
    local install=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --install) install=1; shift ;;
            -h|--help) printf 'usage: boxy ssh-config [--install]\n'; return 0 ;;
            *) die "ssh-config: unknown option $1" ;;
        esac
    done

    local out
    out="$(write_ssh_config)"
    if [ "$install" = "0" ]; then
        cat "$out"
        note ""
        note "wrote $out — use it with: ssh -F $out <name>"
        note "or run 'boxy ssh-config --install' to Include it from ~/.ssh/config"
        return 0
    fi

    local usercfg="$HOME/.ssh/config" line
    line="Include $out"
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    touch "$usercfg"; chmod 600 "$usercfg"
    if grep -qF "$line" "$usercfg"; then
        ok "~/.ssh/config already includes boxy hosts"
        return 0
    fi
    cp "$usercfg" "$usercfg.boxy-backup.$(date +%s)"
    # Include must lead the file: ssh takes the first value it obtains for
    # each keyword, so an Include placed after a `Host *` block would lose.
    printf '%s\n\n%s' "$line" "$(cat "$usercfg")" > "$usercfg.tmp"
    mv "$usercfg.tmp" "$usercfg"
    chmod 600 "$usercfg"
    ok "added '$line' to the top of ~/.ssh/config (backup alongside it)"
}

# ===========================================================================
# ls / info
# ===========================================================================
cmd_ls() {
    require_docker
    local names
    names="$(list_instances)"
    if [ -z "$names" ]; then
        info "no boxy instances"
        return 0
    fi
    printf '%-12s %-9s %-6s %-8s %s\n' NAME STATUS SSH NET WORKDIR
    local n status
    for n in $names; do
        inst_label_load "$n"
        [ "$(inst_label "$n" boxy.role)" = "box" ] || continue
        status="$(docker inspect -f '{{.State.Status}}' "$n")"
        printf '%-12s %-9s %-6s %-8s %s\n' \
            "$n" "$status" \
            "$(inst_label "$n" boxy.ssh_port)" \
            "$(inst_label "$n" boxy.net)" \
            "$(inst_label "$n" boxy.workdir)"
    done
}

# Reality checks against the labels.
#
# A label records what you ASKED FOR at create time. Most of them cannot
# subsequently be wrong — ssh_port and published agree with `docker port` by
# construction, and user/caps/created are fixed for the life of the container.
# Four can drift, all of them verified to do so:
#
#   workdir          you deleted or moved the directory; /work silently
#                    becomes an empty mount rather than an error
#   worktree_repo    same, for the repository the box branches from
#   worktree_branch  you renamed the branch, or the box checked out another
#
# `net` used to belong on that list. It no longer can: isolation is a property
# of the box's network, which Docker enforces and a restart cannot undo.
#
# These print ALONGSIDE the label, never instead of it. The label is what you
# asked for and the divergence is the news; replacing one with the other would
# hide exactly the failure worth reporting — a box that reads `net none` while
# holding a route out is the bug, and showing `net full` would erase it.
#
# All three are answered entirely on the host — /work and the git dir are bind
# mounts, so the host and the box see identical bytes. Nothing here enters the
# container, so there is no flag to opt out of and nothing a box could spoof.
check_workdir() {
    local wd="$1"
    [ -n "$wd" ] || return 0
    [ -d "$wd" ] || printf '%s' "MISSING on the host"
}
check_repo() {
    local repo="$1"
    [ -n "$repo" ] || return 0
    [ -d "$repo" ] || printf '%s' "MISSING on the host"
}

# Which branch the worktree is actually on — read on the HOST.
#
# There is nothing to ask the container. /work is a bind mount of a host
# directory and the git dir is a host directory, so the box and the host are
# looking at the same bytes: a `git checkout` performed inside the box is
# visible here immediately (verified). Reaching in with `docker exec` for this
# was simply wrong — it cost ~200ms, needed a running box, and had to cope
# with docker's own failure modes to learn something a local `git` already
# knows. It costs nothing, so it always runs.
check_branch() {
    local wd="$1" want="$2" actual
    [ -n "$want" ] || return 0
    [ -d "$wd" ] || return 0        # already reported by check_workdir
    if ! actual="$(git -C "$wd" branch --show-current 2>/dev/null)"; then
        printf '%s' "not a readable git worktree any more"
    elif [ -z "$actual" ]; then
        printf '%s' "detached HEAD, not on a branch"
    elif [ "$actual" != "$want" ]; then
        printf '%s' "now on '$actual'"
    fi
}

cmd_info() {
    require_docker
    # Every check here is answered on the host, so there is nothing to opt out
    # of. `net` used to need a docker exec because isolation lived inside the
    # container; it is now a property of the network and cannot drift.
    local pos=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                printf 'usage: boxy info [NAME]\n\n' >&2
                printf '  Labels are shown, with any that no longer match\n' >&2
                printf '  reality flagged beside them.\n' >&2
                return 0 ;;
            *) pos="$1"; shift ;;
        esac
    done
    local name; name="$(resolve_instance "$pos")"
    inst_label_load "$name"
    local sdir; sdir="$(state_dir_for "$name")"
    local pubmap; pubmap="$(inst_label "$name" boxy.published)"
    printf 'name        %s\n' "$name"
    printf 'status      %s\n' "$(docker inspect -f '{{.State.Status}}' "$name")"
    printf 'created     %s\n' "$(inst_label "$name" boxy.created)"
    printf 'user        %s\n' "$(inst_label "$name" boxy.user)"
    printf 'ssh         ssh -F %s %s\n' "$(ssh_config_path)" "$name"
    printf 'ssh port    %s\n' "$(inst_label "$name" boxy.ssh_port)"

    local wd wtb wtr net user bad
    wd="$(inst_label "$name" boxy.workdir)"
    wtb="$(inst_label "$name" boxy.worktree_branch)"
    wtr="$(inst_label "$name" boxy.worktree_repo)"
    net="$(inst_label "$name" boxy.net)"

    bad="$(check_workdir "$wd")"
    printf 'workdir     %s -> /work' "$wd"
    [ -n "$bad" ] && printf '   %s⚠ %s%s' "$C_RED" "$bad" "$C_OFF"
    printf '\n'

    if [ -n "$wtb" ]; then
        bad="$(check_repo "$wtr")"
        printf 'branch      %s in %s' "$wtb" "$wtr"
        [ -n "$bad" ] && printf '   %s⚠ %s%s' "$C_RED" "$bad" "$C_OFF"
        printf '\n'
        bad="$(check_branch "$wd" "$wtb")"
        [ -n "$bad" ] && printf '            %s⚠ %s%s\n' "$C_RED" "$bad" "$C_OFF"
    fi

    printf 'net         %s' "$net"
    [ "$net" != "full" ] && printf '   %s(enforced by docker: %s is internal)%s' \
        "$C_DIM" "boxy-iso-$name" "$C_OFF"
    printf '\n'

    printf 'caps        %s\n' "$(inst_label "$name" boxy.caps)"
    printf 'state       %s\n' "$sdir"
    local pair
    if [ -n "$pubmap" ]; then
        printf 'published   '
        for pair in $pubmap; do
            printf 'localhost:%s -> %s   ' "${pair%%:*}" "${pair##*:}"
        done
        printf '\n'
    else
        printf 'published   (none)\n'
    fi
    printf 'forwardable %s   %s(boxy forward %s)\n' "$BOXY_PORTS" "$C_DIM$C_OFF" "$name"
    if [ "$(inst_label "$name" boxy.net)" = "limited" ]; then
        printf 'sidecar     boxy-sidecar-%s (docker logs boxy-sidecar-%s for denials)\n' "$name" "$name"
    fi
}

cmd_password() {
    local name; name="$(resolve_instance "${1:-}")"
    local f; f="$(state_dir_for "$name")/password"
    [ -f "$f" ] || die "no stored password for $name"
    cat "$f"
}
# ===========================================================================
# env
# ===========================================================================
# One file in the box, /etc/boxy-env, holding KEY=VALUE one per line. Two
# things read it, and the entrypoint already writes both of them for the
# `cd /work` feature, so this needs no new machinery in the image:
#
#   /etc/profile.d/boxy-env.sh   the loader. Login shells run every profile.d
#                                snippet, which covers an interactive
#                                `ssh box` and `boxy exec`.
#   ~/.bashrc                    the boxy block at the top sources that loader.
#                                Bash reads .bashrc even for a NON-interactive
#                                `ssh box cmd` when sshd started it — the case
#                                an agent driving the box hits constantly, and
#                                the one that reads no profile at all.
#
# So there is no host-side copy and nothing to replay on start: the file lives
# in the container, and the container filesystem survives a restart untouched.
# An earlier draft used /etc/environment for the non-interactive case, which
# forced host state, because the entrypoint truncates that file on every start.
# ~/.bashrc reaches the same case with none of it.
BOXY_ENV_FILE=/etc/boxy-env

# PATH is refused because the box's own is set from the image and replacing it
# breaks every command in the box. BOXY_* is refused because that is boxy's
# channel into the entrypoint.
env_key_ok() {
    case "$1" in
        PATH|BOXY_*) return 1 ;;
    esac
    printf '%s' "$1" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$'
}

box_env_read() { docker exec "$1" cat "$BOXY_ENV_FILE" 2>/dev/null || true; }

# Over stdin, so a value never passes through a shell on the way in. There is
# nothing to quote and nothing to escape.
box_env_write() {
    printf '%s' "$2" | docker exec -i -u root "$1" \
        sh -c "cat > $BOXY_ENV_FILE && chmod 644 $BOXY_ENV_FILE"
}

cmd_env() {
    require_docker
    local name="" mode="set"
    local keys=() vals=() unsets=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --unset) mode="unset"; shift ;;
            -h|--help)
                printf 'usage: boxy env [NAME] [KEY=VALUE ...] [--unset KEY ...]\n'
                printf '  with no assignments, lists what is set\n'
                printf '  in a session already open: . /etc/profile.d/boxy-env.sh\n'
                return 0 ;;
            -*) die "env: unknown option $1" ;;
            *=*) keys[${#keys[@]}]="${1%%=*}"; vals[${#vals[@]}]="${1#*=}"; shift ;;
            *)
                if [ "$mode" = "unset" ]; then
                    unsets[${#unsets[@]}]="$1"
                elif [ -z "$name" ]; then
                    name="$1"
                else
                    die "env: '$1' is neither NAME nor KEY=VALUE"
                fi
                shift ;;
        esac
    done
    name="$(resolve_instance "$name")"

    local current; current="$(box_env_read "$name")"
    if [ "${#keys[@]}" -eq 0 ] && [ "${#unsets[@]}" -eq 0 ]; then
        if [ -n "$current" ]; then printf '%s\n' "$current"
        else info "no variables set for $name"; fi
        return 0
    fi

    docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null | grep -q true \
        || die "env: $name is not running — the variables live in the box, so start it first"

    local k v i=0
    for k in ${keys[@]+"${keys[@]}"}; do
        env_key_ok "$k" \
            || die "env: refusing '$k' — names must be identifiers, and PATH and BOXY_* belong to boxy"
    done
    while [ "$i" -lt "${#keys[@]}" ]; do
        case "${vals[$i]}" in
            *"
"*) die "env: ${keys[$i]} has a newline in its value; the file is one variable per line" ;;
        esac
        i=$(( i + 1 ))
    done

    # Everything we are not touching, then the new set — so a key set twice
    # appears once, with the newer value.
    local out="" line skip
    if [ -n "$current" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            k="${line%%=*}"
            skip=0
            for v in ${keys[@]+"${keys[@]}"} ${unsets[@]+"${unsets[@]}"}; do
                [ "$k" = "$v" ] && skip=1
            done
            [ "$skip" = "1" ] || out="$out$line
"
        done <<< "$current"
    fi
    i=0
    while [ "$i" -lt "${#keys[@]}" ]; do
        out="$out${keys[$i]}=${vals[$i]}
"
        i=$(( i + 1 ))
    done

    box_env_write "$name" "$out"
    local n; n="$(printf '%s' "$out" | grep -c . || true)"
    ok "$name now has $n variable(s) set"
    note "new ssh sessions and 'boxy exec' see them; they survive a restart"
    note "in a session already open: . /etc/profile.d/boxy-env.sh"
}

# ===========================================================================
# ssh / exec / forward
# ===========================================================================
cmd_ssh() {
    require_docker
    # `boxy ssh -- cmd` with a single box: the -- is a separator, not a name.
    if [ "${1:-}" = "--" ]; then shift; set -- "" "$@"; fi
    local name; name="$(resolve_instance "${1:-}")"
    shift || true
    if [ "${1:-}" = "--" ]; then shift; fi
    local cfg; cfg="$(write_ssh_config)"
    exec ssh -F "$cfg" "$name" "$@"
}

cmd_exec() {
    require_docker
    local name; name="$(resolve_instance "${1:-}")"
    shift || true
    local user home
    user="$(inst_label "$name" boxy.user)"

    # `docker exec -u` switches the UID but NOT $HOME — that comes from the
    # image's ENV, which is root's. A login shell then tries to source
    # /root/.bash_profile and the box user gets "Permission denied". sshd does
    # not have this problem (PAM sets HOME from the passwd entry), so it only
    # ever shows up on this path. Resolve the real home from the container.
    home="$(docker exec "$name" getent passwd "$user" 2>/dev/null | cut -d: -f6)"
    [ -n "$home" ] || home="/home/$user"

    # -t only when there really is a terminal on both ends. `docker exec -it`
    # from a script or a pipe fails outright with "cannot attach stdin to a
    # TTY-enabled container", which is a confusing way to say "not a tty".
    local tty_args
    if [ -t 0 ] && [ -t 1 ]; then tty_args="-i -t"; else tty_args="-i"; fi

    if [ $# -eq 0 ]; then
        # Without a terminal there is nothing to drive an interactive shell,
        # and `bash -l` on a pipe just blocks forever. Fail with a reason
        # instead of hanging.
        [ -t 0 ] && [ -t 1 ] \
            || die "boxy exec with no command needs a terminal; pass a command, e.g. 'boxy exec $name \"ls /work\"'"
        # shellcheck disable=SC2086
        exec docker exec $tty_args -u "$user" -e "HOME=$home" -w /work "$name" bash -l
    fi
    # shellcheck disable=SC2086
    exec docker exec $tty_args -u "$user" -e "HOME=$home" -w /work "$name" bash -lc "$*"
}

cmd_forward() {
    require_docker
    local name="" bg=0 stop=0 want_ports=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bg)   bg=1; shift ;;
            --stop) stop=1; shift ;;
            -h|--help)
                printf 'usage: boxy forward [NAME] [--bg|--stop] [PORT ...]\n'
                printf '  tunnels container ports to the SAME port number on localhost\n'
                return 0 ;;
            *)
                # \+ is a GNU grep extension; -E keeps this working on BSD grep.
                if [ -z "$name" ] && ! printf '%s' "$1" | grep -qE '^[0-9]+$'; then
                    name="$1"
                else
                    want_ports="$want_ports $1"
                fi
                shift ;;
        esac
    done
    name="$(resolve_instance "$name")"
    local pidfile; pidfile="$(state_dir_for "$name")/forward.pid"

    if [ "$stop" = "1" ]; then
        [ -f "$pidfile" ] || die "no background tunnel recorded for $name"
        kill "$(cat "$pidfile")" 2>/dev/null || true
        rm -f "$pidfile"
        ok "stopped tunnel for $name"
        return 0
    fi

    [ -n "$want_ports" ] || want_ports="$BOXY_PORTS"

    # -L PORT:127.0.0.1:PORT keeps the number identical on both sides, which
    # is the point: a marimo server on :2718 in the box is on :2718 here.
    local sshargs=() p
    for p in $want_ports; do
        port_free "$p" || { warn "localhost:$p is already in use — skipping"; continue; }
        sshargs[${#sshargs[@]}]="-L"
        sshargs[${#sshargs[@]}]="127.0.0.1:$p:127.0.0.1:$p"
    done
    [ "${#sshargs[@]}" -gt 0 ] || die "no ports available to forward"

    local cfg; cfg="$(write_ssh_config)"
    if [ "$bg" = "1" ]; then
        # Detach stdio. A backgrounded process that keeps the caller's stdout
        # open leaves any script running `boxy forward --bg` waiting on the
        # pipe forever — the command "returns" but the shell never does.
        local fwdlog; fwdlog="$(state_dir_for "$name")/forward.log"
        ssh -F "$cfg" -N -T -o ExitOnForwardFailure=yes "${sshargs[@]}" "$name" \
            >"$fwdlog" 2>&1 </dev/null &
        printf '%s\n' "$!" > "$pidfile"
        ok "tunnelling$want_ports in the background (boxy forward $name --stop to end)"
        note "tunnel output: $fwdlog"
        return 0
    fi
    info "tunnelling$want_ports — Ctrl-C to stop"
    exec ssh -F "$cfg" -N -T -o ExitOnForwardFailure=yes "${sshargs[@]}" "$name"
}

# ===========================================================================
# lifecycle
# ===========================================================================
cmd_stop() {
    require_docker
    local name; name="$(resolve_instance "${1:-}")"
    docker stop "$name" >/dev/null
    docker stop "boxy-sidecar-$name" >/dev/null 2>&1 || true
    ok "stopped $name"
}

cmd_start() {
    require_docker
    local name; name="$(resolve_instance "${1:-}")"
    docker start "boxy-sidecar-$name" >/dev/null 2>&1 || true
    docker start "$name" >/dev/null
    # Nothing to reapply: isolation belongs to the network, not to the running
    # container, so it is already in force before this returns.
    wait_for_ready "$name" || warn "$name started but is not answering SSH yet"
    ok "started $name (ssh port $(inst_label "$name" boxy.ssh_port))"
}

cmd_restart() { cmd_stop "$@"; cmd_start "$@"; }

cmd_logs() {
    require_docker
    local name; name="$(resolve_instance "${1:-}")"
    shift || true
    exec docker logs "$@" "$name"
}

# Remove a box. One behaviour, no flags, no confirmation — because nothing it
# deletes is yours. The container goes, and so does boxy's per-instance
# bookkeeping (host key, known_hosts, password), which only ever had meaning
# while the box existed. Your files are never touched: a -d directory is left
# exactly as it was, and a scratch workdir is left in the OS temp area for the
# OS to reap on its own schedule.
# Retire a worktree checkout, and never the work in it.
#
# The branch always survives: it can hold the only copy of what you did, and
# boxy is not the thing that decides that is finished. `git worktree remove`
# without --force is the safety interlock — it refuses on uncommitted changes,
# so a dirty tree is reported and left exactly where it is.
rm_worktree() {
    local repo="$1" branch="$2" path="$3"
    if [ ! -d "$repo" ]; then
        note "  repo $repo is gone; worktree left at $path"
        return 0
    fi
    if git -C "$repo" worktree remove "$path" >/dev/null 2>&1; then
        note "  worktree removed; branch $branch is still in $repo"
    else
        note "  worktree has uncommitted changes — left at $path"
        note "  keep it, or discard it with:"
        note "    git -C $repo worktree remove --force $path"
    fi
}

cmd_rm() {
    require_docker
    local names=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                printf 'usage: boxy rm NAME...\n\n' >&2
                printf 'Removes the container and boxy'"'"'s bookkeeping for it.\n' >&2
                printf 'Never touches a -d directory; leaves a scratch workdir\n' >&2
                printf 'in %s for the OS to clean up.\n' "$BOXY_WORKDIR_BASE" >&2
                return 0 ;;
            -f|--force|--purge)
                # Accepted and ignored: these existed when rm had a destructive
                # mode. It no longer does.
                shift ;;
            *) names[${#names[@]}]="$1"; shift ;;
        esac
    done
    [ "${#names[@]}" -gt 0 ] || die "rm: name required"

    local name sdir workdir net wt_repo wt_branch
    for name in "${names[@]}"; do
        require_instance "$name"
        inst_label_load "$name"
        sdir="$(state_dir_for "$name")"
        workdir="$(inst_label "$name" boxy.workdir)"
        net="$(inst_label "$name" boxy.net)"
        wt_repo="$(inst_label "$name" boxy.worktree_repo)"
        wt_branch="$(inst_label "$name" boxy.worktree_branch)"

        docker rm -f "$name" >/dev/null 2>&1 || true
        docker rm -f "boxy-sidecar-$name" >/dev/null 2>&1 || true
        [ "$net" != "full" ] && remove_network_if_unused "boxy-iso-$name"
        remove_network_if_unused "boxy-egress"

        case "$sdir" in
            "$BOXY_STATE_DIR"/instances/*) rm -rf "$sdir" ;;
            *) warn "refusing to remove unexpected state path $sdir" ;;
        esac

        ok "removed $name"
        # Tell them where the files are, since that is the only thing that
        # outlives the box and the only thing worth caring about.
        if [ -n "$wt_repo" ]; then
            rm_worktree "$wt_repo" "$wt_branch" "$workdir"
        else
            case "$workdir" in
                "$BOXY_WORKDIR_BASE"/*) note "  workdir left for the OS to reap: $workdir" ;;
                *)                      note "  your directory is untouched: $workdir" ;;
            esac
        fi
    done
    write_ssh_config >/dev/null
}

# ===========================================================================
# monitoring
# ===========================================================================
# A point-in-time read straight from the daemon: no containers, no retention,
# nothing to run first. It answers "what is running and what is it using",
# which is what you actually want at a keyboard.
cmd_top() {
    require_docker
    local names watch=0
    [ "${1:-}" = "--watch" ] || [ "${1:-}" = "-w" ] && watch=1
    names="$(docker ps --filter 'label=boxy.managed=1' --format '{{.Names}}' | tr '\n' ' ')"
    if [ -z "$(printf '%s' "$names" | tr -d ' ')" ]; then
        info "no running boxy instances"
        return 0
    fi
    # shellcheck disable=SC2086
    if [ "$watch" = "1" ]; then
        exec docker stats $names
    fi
    # shellcheck disable=SC2086
    docker stats --no-stream \
        --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}' \
        $names
}

# ===========================================================================
# doctor / config
# ===========================================================================
cmd_doctor() {
    local problems=0 verbose=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -v|--verbose) verbose=1; shift ;;
            -h|--help)
                printf 'usage: boxy doctor [--verbose]\n\n' >&2
                printf '  -v, --verbose  also print `boxy info` for every box\n' >&2
                return 0 ;;
            *) die "doctor: unknown option $1" ;;
        esac
    done
    printf 'boxy %s\n\n' "$BOXY_VERSION"

    if command -v docker >/dev/null 2>&1; then
        printf '  %-24s %s\n' "docker cli" "$(docker version --format '{{.Client.Version}}' 2>/dev/null || echo '?')"
        if docker info >/dev/null 2>&1; then
            printf '  %-24s %s\n' "docker daemon" "reachable"
        else
            printf '  %-24s %sNOT REACHABLE%s\n' "docker daemon" "$C_RED" "$C_OFF"; problems=$(( problems + 1 ))
        fi
    else
        printf '  %-24s %sMISSING%s\n' "docker cli" "$C_RED" "$C_OFF"; problems=$(( problems + 1 ))
    fi

    local img
    for img in "$BOXY_IMAGE" "$BOXY_PROXY_IMAGE"; do
        if image_exists "$img"; then
            printf '  %-24s %s\n' "image $img" "present"
        else
            printf '  %-24s %smissing%s (boxy build)\n' "image $img" "$C_YEL" "$C_OFF"
        fi
    done

    if [ -f "$BOXY_SSH_KEY.pub" ]; then
        printf '  %-24s %s\n' "boxy keypair" "$BOXY_SSH_KEY"
    else
        printf '  %-24s %snot yet generated%s (created on first boxy create)\n' \
            "boxy keypair" "$C_YEL" "$C_OFF"
    fi

    if [ -f "$(wordlist_path)" ]; then
        printf '  %-24s %s words cached\n' "EFF wordlist" "$(wc -l < "$(wordlist_path)" | tr -d ' ')"
    else
        printf '  %-24s %snot cached%s (fetched on first create)\n' "EFF wordlist" "$C_YEL" "$C_OFF"
    fi

    printf '  %-24s %s\n' "config" "$BOXY_CONFIG_FILE"
    printf '  %-24s %s\n' "state" "$BOXY_STATE_DIR"

    if docker info >/dev/null 2>&1; then
        local boxes orphans
        boxes="$(list_instances | grep -c . || true)"
        orphans="$(orphan_state_dirs | grep -c . || true)"
        printf '  %-24s %s\n' "boxes" "$boxes"
        if [ "$orphans" -gt 0 ]; then
            printf '  %-24s %s%s%s (removed outside boxy; the next create clears them)\n' \
                "orphaned state" "$C_YEL" "$orphans" "$C_OFF"
        fi

        # --verbose prints the full per-box report.
        if [ "$verbose" = "1" ] && [ "$boxes" -gt 0 ]; then
            local b
            for b in $(list_instances); do
                printf '\n  %s─── %s %s%s\n' "$C_DIM" "$b" \
                    "$(printf '%.0s─' 1 2 3 4 5 6 7 8 9)" "$C_OFF"
                cmd_info "$b" | sed 's/^/  /'
            done
        fi
    fi
    printf '\n'
    [ "$problems" -eq 0 ] || die "$problems problem(s) found"
    ok "looks healthy"
}

# `--init [FROM]` installs a config file at the path boxy actually reads.
#
# The argument is the SOURCE, not the destination. Writing to an arbitrary
# destination would produce a config boxy ignores unless you also set
# BOXY_CONFIG_FILE — a result that needs a footnote to be useful. Installing
# to the active path instead means the file is in effect the moment it lands,
# and BOXY_CONFIG_FILE still chooses where "active" is.
cmd_config() {
    local action="show" source=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --init) action="init"; shift ;;
            -h|--help)
                printf 'usage: boxy config [--init [FROM]]\n'
                printf '  (no arguments)  show the effective configuration\n'
                printf '  --init          install the bundled example as your config\n'
                printf '  --init FROM     install FROM as your config instead\n\n'
                printf 'installs to: %s\n' "$BOXY_CONFIG_FILE"
                printf 'set BOXY_CONFIG_FILE to install somewhere else.\n'
                return 0 ;;
            -*) die "config: unknown option $1 (try 'boxy config --help')" ;;
            *)
                # Silently ignoring this used to be the failure mode: a
                # positional was dropped and `--init` reported success naming
                # a file the caller never mentioned.
                [ "$action" = "init" ] \
                    || die "config: unexpected argument '$1' (try 'boxy config --help')"
                [ -z "$source" ] \
                    || die "config: one source at a time (got '$source' and '$1')"
                source="$1"; shift ;;
        esac
    done

    if [ "$action" = "init" ]; then
        [ -n "$source" ] || source="$SELF_DIR/boxy.conf.example"
        [ -f "$source" ] || die "config: no such file: $source"
        [ -r "$source" ] || die "config: cannot read $source"
        if [ -f "$BOXY_CONFIG_FILE" ]; then
            die "$BOXY_CONFIG_FILE already exists — move it aside first"
        fi
        # dirname of the destination, not BOXY_CONFIG_DIR. They differ whenever
        # BOXY_CONFIG_FILE is set on its own, and the old code created the wrong
        # directory and then failed with a bare `cp:` error.
        mkdir -p "$(dirname "$BOXY_CONFIG_FILE")" \
            || die "config: cannot create $(dirname "$BOXY_CONFIG_FILE")"
        cp "$source" "$BOXY_CONFIG_FILE" \
            || die "config: could not write $BOXY_CONFIG_FILE"
        ensure_allowlist
        ok "wrote $BOXY_CONFIG_FILE"
        [ "$source" = "$SELF_DIR/boxy.conf.example" ] || note "copied from $source"
        return 0
    fi

    printf 'config file  %s%s\n' "$BOXY_CONFIG_FILE" \
        "$( [ -f "$BOXY_CONFIG_FILE" ] || printf ' (not present; boxy config --init)' )"
    local k
    for k in BOXY_STATE_DIR BOXY_WORKDIR_BASE BOXY_IMAGE BOXY_PROXY_IMAGE BOXY_USER BOXY_SSH_KEY \
             BOXY_SSH_PORT_BASE BOXY_PORTS \
             BOXY_BIND_ADDR BOXY_NET BOXY_CAPS BOXY_RESTART \
             BOXY_CPUS BOXY_MEMORY; do
        eval "printf '%-20s %s\n' $k \"\$$k\""
    done
    printf '%-20s %s\n' allowlist "$(allowlist_file)"
}

# ===========================================================================
# dispatch
# ===========================================================================
usage() {
    cat >&2 <<EOF
boxy $BOXY_VERSION — disposable SSH-reachable dev boxes

usage: boxy <command> [options]

CORE
  create [TARGET]            . | worktree | PATH, or nothing for scratch
  ssh [NAME] [-- CMD]        interactive session, or one command
  forward [NAME] [PORTS]     tunnel box ports to the SAME local ports
  rm NAME...                 remove a box (doesn't touch your files)
  ls                         list boxes
  info [NAME]                one box in detail, config vs reality
  password [NAME]            print the stored sudo password
  env [NAME] [K=V ...]       list or set/inject env vars
  ssh-config [--install]     emit/install ssh_config for every box
  build [--full]             build the images
  doctor [--verbose]         check the local setup; -v adds per-box info
  config [--init]            show or scaffold configuration

DOCKER PASSTHROUGH — resolve the box name, then hand off to docker
  exec [NAME] [CMD]          adds defaults: as box user, at /work
  logs [NAME] [-f]           the box's entrypoint narration
  start|stop|restart [NAME]  lifecycle + ensures sidecar follows box
  top [--watch]              [docker stats] for boxes and sidecars

The name may be omitted whenever exactly one box exists.
Full options: boxy create --help, boxy build --help
EOF
}

main() {
    load_config
    apply_derived_defaults
    local cmd="${1:-}"
    [ $# -gt 0 ] && shift || true
    case "$cmd" in
        build)       cmd_build "$@" ;;
        create|new)  cmd_create "$@" ;;
        ls|list|ps)  cmd_ls "$@" ;;
        info)        cmd_info "$@" ;;
        ssh)         cmd_ssh "$@" ;;
        exec|sh)     cmd_exec "$@" ;;
        forward|fwd) cmd_forward "$@" ;;
        password|pw) cmd_password "$@" ;;
        env)         cmd_env "$@" ;;
        ssh-config)  cmd_ssh_config "$@" ;;
        start)       cmd_start "$@" ;;
        stop)        cmd_stop "$@" ;;
        restart)     cmd_restart "$@" ;;
        logs)        cmd_logs "$@" ;;
        rm|destroy)  cmd_rm "$@" ;;
        top|stats)   cmd_top "$@" ;;
        doctor)      cmd_doctor "$@" ;;
        config)      cmd_config "$@" ;;
        -v|--version) printf 'boxy %s\n' "$BOXY_VERSION" ;;
        ""|-h|--help) usage ;;
        *)           usage; die "unknown command: $cmd" ;;
    esac
}

main "$@"
