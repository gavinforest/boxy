# boxy configuration — copy to ~/.config/boxy/config (or run `boxy config --init`).
#
# This file is sourced by bash, so it is shell syntax. Anything you leave
# commented keeps its built-in default. Environment variables you export
# before running boxy win over this file; command-line flags win over both.

# --- identity -------------------------------------------------------------

# The keypair boxy authorizes on every box it creates. Generated automatically
# on first `boxy create` if absent. It defaults into boxy's OWN state dir
# rather than ~/.ssh, so boxy never writes to your ssh directory and deleting
# BOXY_STATE_DIR is a complete uninstall. Point it at your own key if you have
# one you would rather use.
#BOXY_SSH_KEY="$BOXY_STATE_DIR/boxy_ed25519"

# Private key bind-mounted read-only into each box so git can reach GitHub.
# The box user can read it — that is the price of being able to push from
# inside. Set to "" (or pass --no-git-key) to withhold it.
#BOXY_GIT_KEY="$HOME/.ssh/id_ed25519"

# Login user inside the box.
#BOXY_USER=boxyboy

# --- images ---------------------------------------------------------------
#BOXY_IMAGE=boxy:latest
#BOXY_PROXY_IMAGE=boxy-proxy:latest

# --- networking -----------------------------------------------------------

# Instance N gets SSH on BOXY_SSH_PORT_BASE + N - 1, so boxy-1 is 2200.
#BOXY_SSH_PORT_BASE=2200

# The set of container ports `boxy forward` tunnels when you don't name any.
# These are NOT published to the host automatically — publishing is explicit,
# via `boxy create -p PORT` or `-p HOSTPORT:PORT`.
# 2718 marimo · 8888 jupyter · 8000/8080 http · 3000 node · 5000 flask · 6006 tensorboard
#BOXY_PORTS="2718 8888 8000 8080 3000 5000 6006"

# Interface published ports bind to. Loopback by default — on a VPS you should
# reach boxes over tailscale, not by exposing SSH to the internet. Setting this
# to 0.0.0.0 puts every box's SSH port on the public interface.
#BOXY_BIND_ADDR=127.0.0.1

# Host that generated ssh_config entries point at.
#BOXY_SSH_HOST=127.0.0.1

# Default egress policy: full | none | limited
#BOXY_NET=full

# --- passwords ------------------------------------------------------------

# Words drawn from the EFF long (7776-word) list. 4 words is ~51.7 bits.
#BOXY_PASSWORD_WORDS=4

# --- resources ------------------------------------------------------------
#BOXY_RESTART=unless-stopped
#BOXY_CPUS=
#BOXY_MEMORY=

# --- tailscale ------------------------------------------------------------

# Reusable, ephemeral, pre-authorized auth key from the Tailscale admin
# console. Ephemeral keys are the right kind here: nodes disappear from the
# tailnet when a box is destroyed instead of accumulating as dead entries.
# Prefer exporting this from a secret store over writing it here.
#BOXY_TS_AUTHKEY="tskey-auth-..."

# --- paths ----------------------------------------------------------------

# boxy's own bookkeeping: host keys, known_hosts, the password file. Exists
# only while a box does; `boxy rm` deletes a box's entry.
#BOXY_STATE_DIR="$HOME/.local/share/boxy"

# Where a box's workdir goes when you don't pass -d. Scratch space belongs in
# the OS temp area: boxy creates a fresh directory per box and then leaves it
# alone, so the OS reaps it on its own schedule and there is no lifecycle to
# think about. A directory you pass with -d is yours and is never touched.
#BOXY_WORKDIR_BASE="${TMPDIR:-/tmp}/boxy"
